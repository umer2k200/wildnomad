# Same Supabase project as the Wild Nomad mobile app (Travel 2)

# Public
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Server only — never expose as NEXT_PUBLIC_*
# Optional: Dashboard → Project Settings → API → service_role
# Waitlist works with anon alone (RLS allows INSERT, denies SELECT).
SUPABASE_SERVICE_ROLE_KEY=
